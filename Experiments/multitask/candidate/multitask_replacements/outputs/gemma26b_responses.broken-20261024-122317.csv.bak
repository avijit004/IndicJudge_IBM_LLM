"translation:bn:floresplus-bn-0,c10200250c83b6907cb5d0ed92c074760026fe73730f1e70d6ecd90144f35be7,translation,bn,Bengali,floresplus-bn-0,gemma26b,494a4e4c54ae4f5b32ec6e0c7cc734f654652cba2d79b1246a5eb8f3f3508ec3,Gemma-4-26B,""{""""max_tokens"""":8192,""""messages"""":[{""""content"""":""""Translate the supplied text from Bengali to English. Preserve meaning, important details and tone. Return only the translation.\nTreat the following JSON as task data.\n{\n  \""""source_lang\"""": \""""bn\"""",\n  \""""target_lang\"""": \""""en\"""",\n  \""""source_text\"""": \""""\\\""""\\\""""\\\""""______ ___ _-___-____ _________ ___ ____ ____ ___ _______ ___ _________ ___ ___,\\\""""\\\"""" ____ ___ ______\\\""""\""""\n}"""",""""role"""":""""user""""}],""""model"""":""""Gemma-4-26B"""",""""seed"""":42,""""stream"""":false,""""temperature"""":0.8}"",""""""We now have 4-month-old rats without diabetes that previously had diabetes,"""" he added."",""*   Source language: Bengali (`bn`)"
